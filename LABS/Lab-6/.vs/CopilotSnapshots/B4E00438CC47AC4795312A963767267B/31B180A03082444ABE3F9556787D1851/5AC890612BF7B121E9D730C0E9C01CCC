    public static void program3()
    {
        Dictionary<int, String> Student = new Dictionary<int, String>();
        int choice;
        
        do
        {
            Console.WriteLine("Enter the choice from the following ----- ");
            Console.WriteLine(" 1. Add ");
            Console.WriteLine(" 2. Update ");
            Console.WriteLine(" 3. Delete ");
            Console.WriteLine(" 4. Display ");
            Console.WriteLine(" 5. Exit the program ! ");
            choice  = Convert.ToInt32(Console.ReadLine());


            switch (choice)
            {
                case 1:
                    Console.WriteLine("Enter the student id : ");
                    int id = Convert.ToInt32(Console.ReadLine());
                    Console.WriteLine("Enter the student name :   ");
                    string name = Console.ReadLine();
                    Student.Add(id, name);
                    break;

                case 2:
                    Console.WriteLine("Enter the student id to update : ");
                    int update_id = Convert.ToInt32(Console.ReadLine());
                    if (Student.ContainsKey(update_id))
                    {
                        Console.WriteLine("Enter the new name : ");
                        string new_name = Console.ReadLine();
                        Student[update_id] = new_name;
                    }
                    else
                    {
                        Console.WriteLine("Student not found");
                    }
                    break;


                case 3:
                    Console.WriteLine("Enter the student id to delete : ");
                    int delete_id = Convert.ToInt32(Console.ReadLine());
                    if (Student.ContainsKey(delete_id))
                    {
                        Student.Remove(delete_id);
                        Console.WriteLine("Student removed.");
                    }
                    else
                    {
                        Console.WriteLine("Student not found");
                    }
                    break;

                case 4:
                    Console.WriteLine("The display of dictionary is --- ");
                    foreach(var item in Student)
                    {
                        Console.WriteLine("Student id : " + item.Key + " Student name : " + item.Value);
                    }
                    break;

                case 5:
                    Console.WriteLine("Exiting the program...");
                    break;
            }


        } while (choice != 5);
        
    }

