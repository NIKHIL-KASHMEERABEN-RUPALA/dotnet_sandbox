    public static void program1()
    {

        ArrayList student = new ArrayList();

        while (true)
        {
            Console.WriteLine("Enter the choice from the following :");
            Console.WriteLine(" 1. Add");
            Console.WriteLine(" 2. Display");
            Console.WriteLine(" 3. Search");
            Console.WriteLine(" 4. Update");
            Console.WriteLine(" 5. Delete");
            Console.WriteLine(" 6. Exit");

            string? input = Console.ReadLine();
            if (!int.TryParse(input, out int choice))
            {
                Console.WriteLine("Invalid input. Please enter a number.");
                continue;
            }

            switch (choice)
            {
                case 1:
                    Console.WriteLine("Enter the student name : ");
                    string? student_name = Console.ReadLine();
                    if (!string.IsNullOrEmpty(student_name))
                        student.Add(student_name);
                    break;

                case 2:
                    foreach (var items in student)
                    {
                        Console.WriteLine(items);
                    }
                    break;

                case 3:
                    Console.WriteLine("Enter the student name to search : ");
                    string? to_search = Console.ReadLine();
                    Console.WriteLine("List student contains : " + (to_search != null && student.Contains(to_search)));
                    break;

                case 4:
                    Console.WriteLine("Enter the student name to update : ");
                    string? to_update = Console.ReadLine();
                    if (to_update != null && student.Contains(to_update))
                    {
                        Console.WriteLine("Enter the new name : ");
                        string? new_name = Console.ReadLine();
                        int index = student.IndexOf(to_update);
                        if (index >= 0 && new_name != null)
                            student[index] = new_name;
                    }
                    else
                    {
                        Console.WriteLine("Student not found");
                    }
                    break;

                case 5:
                    Console.WriteLine("Enter the student name to delete : ");
                    string? to_delete = Console.ReadLine();
                    if (to_delete != null && student.Contains(to_delete))
                    {
                        student.Remove(to_delete);
                        Console.WriteLine("Student removed.");
                    }
                    else
                    {
                        Console.WriteLine("Student not found");
                    }
                    break;

                case 6:
                    return;

                default:
                    Console.WriteLine("Invalid choice");
                    break;
            }
        }

    }

